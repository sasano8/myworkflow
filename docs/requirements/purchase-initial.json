{
  "roles": [
    {
      "id": "role.requester",
      "name": "購買依頼部門の担当者",
      "display_name": "申請者"
    },
    {
      "id": "role.approver",
      "name": "購買依頼部門の部門長",
      "display_name": "承認者"
    },
    {
      "id": "role.buyer",
      "name": "購買部の発注担当者",
      "display_name": "発注担当者"
    },
    {
      "id": "role.system",
      "name": "購買管理システム",
      "display_name": "システム"
    }
  ],
  "artifacts": [
    {
      "id": "a.id",
      "name": "購買申請ID",
      "key": "application_id",
      "type": "str"
    },
    {
      "id": "a.vendor",
      "name": "取引先",
      "key": "vendor",
      "type": "str"
    },
    {
      "id": "a.amount",
      "name": "申請金額",
      "key": "amount",
      "type": "int"
    },
    {
      "id": "a.status",
      "name": "申請状態",
      "key": "status",
      "type": "str"
    },
    {
      "id": "a.quote-a",
      "name": "見積書A",
      "key": "quote_a",
      "type": "str"
    },
    {
      "id": "a.quote-b",
      "name": "見積書B",
      "key": "quote_b",
      "type": "str"
    },
    {
      "id": "a.receipt",
      "name": "添付登録結果",
      "key": "receipt",
      "type": "str"
    },
    {
      "id": "a.decision",
      "name": "承認判断",
      "key": "decision",
      "type": "bool"
    },
    {
      "id": "a.eligible",
      "name": "発注可能",
      "key": "eligible",
      "type": "bool"
    },
    {
      "id": "a.order",
      "name": "発注番号",
      "key": "order_id",
      "type": "str"
    }
  ],
  "pipelines": [
    {
      "id": "p.submit",
      "name": "購買申請受付",
      "inputs": [
        "a.id",
        "a.vendor",
        "a.amount"
      ],
      "outputs": [
        "a.id",
        "a.status"
      ],
      "steps": [
        {
          "id": "s.submit-lock",
          "name": "申請単位の排他",
          "kind": "lock",
          "reads": [
            "a.id"
          ]
        },
        {
          "id": "s.submit",
          "name": "申請保存",
          "summary": "正の金額と取引先を確認し、申請者に紐づく承認待ちの申請を保存する。",
          "kind": "action",
          "reads": [
            "a.id",
            "a.vendor",
            "a.amount"
          ],
          "writes": [
            "a.status"
          ],
          "uses": [
            [
              "a.id",
              "DB作成"
            ],
            [
              "a.status",
              "保持"
            ]
          ]
        }
      ],
      "reply": true
    },
    {
      "id": "p.upload",
      "name": "見積書2件登録",
      "inputs": [
        "a.id",
        "a.quote-a",
        "a.quote-b"
      ],
      "outputs": [
        "a.receipt"
      ],
      "steps": [
        {
          "id": "s.upload-lock",
          "name": "申請単位の排他",
          "kind": "lock",
          "reads": [
            "a.id"
          ]
        },
        {
          "id": "s.check-upload",
          "name": "添付可否確認",
          "summary": "申請者本人であり、申請が承認待ちであることを確認する。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [],
          "uses": []
        },
        {
          "id": "s.put-a",
          "name": "見積書A保存",
          "summary": "今回の実行専用キーで見積書Aを保存する。",
          "kind": "action",
          "reads": [
            "a.id",
            "a.quote-a"
          ],
          "writes": [],
          "uses": [
            [
              "a.quote-a",
              "参照"
            ]
          ],
          "compensate": "c.delete-a",
          "attempts": 2
        },
        {
          "id": "s.put-b",
          "name": "見積書B保存",
          "summary": "見積書Bを保存し、両方の添付情報を申請に紐づける。",
          "kind": "action",
          "reads": [
            "a.id",
            "a.quote-b"
          ],
          "writes": [
            "a.receipt"
          ],
          "uses": [
            [
              "a.quote-b",
              "参照"
            ],
            [
              "a.receipt",
              "DB作成"
            ]
          ],
          "compensate": "c.delete-b",
          "attempts": 2
        }
      ],
      "reply": true
    },
    {
      "id": "p.approve",
      "name": "承認判断の反映",
      "inputs": [
        "a.id",
        "a.decision"
      ],
      "outputs": [
        "a.status"
      ],
      "steps": [
        {
          "id": "s.approve-lock",
          "name": "申請単位の排他",
          "kind": "lock",
          "reads": [
            "a.id"
          ]
        },
        {
          "id": "s.check-approval",
          "name": "承認対象確認",
          "summary": "承認待ちかつ申請者と承認者が別人であることを確認する。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [],
          "uses": []
        },
        {
          "id": "s.approve",
          "name": "承認",
          "summary": "承認済みに更新する。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [
            "a.status"
          ],
          "uses": [
            [
              "a.status",
              "DB更新"
            ]
          ],
          "when": [
            "a.decision",
            true
          ]
        },
        {
          "id": "s.reject",
          "name": "却下",
          "summary": "却下済みに更新する。発注は行わない。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [
            "a.status"
          ],
          "uses": [
            [
              "a.status",
              "DB更新"
            ]
          ],
          "when": [
            "a.decision",
            false
          ]
        }
      ],
      "reply": true
    },
    {
      "id": "p.dispatch",
      "name": "発注確定の起動",
      "inputs": [
        "a.id"
      ],
      "outputs": [
        "a.id"
      ],
      "steps": [
        {
          "id": "s.dispatch",
          "name": "引継ぎ条件確認",
          "summary": "承認済みの購買申請IDを次ワークフローへ引き継ぐ。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [],
          "uses": []
        }
      ],
      "reply": true
    },
    {
      "id": "p.confirm",
      "name": "発注確定",
      "inputs": [
        "a.id"
      ],
      "outputs": [],
      "steps": [
        {
          "id": "s.order-lock",
          "name": "申請単位の排他",
          "kind": "lock",
          "reads": [
            "a.id"
          ]
        },
        {
          "id": "s.eligibility",
          "name": "発注条件照会",
          "summary": "承認済み、見積書2件あり、未発注であることを確認する。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [
            "a.eligible"
          ],
          "uses": [
            [
              "a.eligible",
              "保持"
            ]
          ]
        },
        {
          "id": "s.confirm",
          "name": "発注確定",
          "summary": "発注作成と申請の発注確定済みへの更新を同一DBトランザクションで行う。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [
            "a.order"
          ],
          "uses": [
            [
              "a.order",
              "DB作成"
            ],
            [
              "a.status",
              "DB更新"
            ]
          ],
          "when": [
            "a.eligible",
            true
          ]
        },
        {
          "id": "s.stop",
          "name": "発注拒否",
          "summary": "発注条件を満たさなければエラーとして終了し、発注しない。",
          "kind": "action",
          "reads": [
            "a.id"
          ],
          "writes": [],
          "uses": [],
          "when": [
            "a.eligible",
            false
          ]
        }
      ],
      "reply": false
    }
  ],
  "workflows": [
    {
      "id": "w.approval",
      "name": "購買申請の受付・承認",
      "bindings": [
        {
          "id": "b.submit",
          "pipeline": "p.submit",
          "triggers": [
            {
              "id": "t.submit",
              "name": "申請者がFEで申請",
              "role": "role.requester",
              "mapping": {
                "a.id": "id",
                "a.vendor": "vendor",
                "a.amount": "amount"
              }
            }
          ]
        },
        {
          "id": "b.approve",
          "pipeline": "p.approve",
          "triggers": [
            {
              "id": "t.approve",
              "name": "承認者がFEで承認または却下",
              "role": "role.approver",
              "mapping": {
                "a.id": "id",
                "a.decision": "decision"
              },
              "wait": "承認イベントを受信"
            }
          ]
        },
        {
          "id": "b.dispatch",
          "pipeline": "p.dispatch",
          "triggers": [
            {
              "id": "t.timer",
              "name": "指定日時に到達",
              "role": "role.system",
              "mapping": {
                "a.id": "id"
              },
              "wait": "承認済みかつ指定日時に到達"
            },
            {
              "id": "t.manual",
              "name": "発注担当者がFEで開始",
              "role": "role.buyer",
              "mapping": {
                "a.id": "application"
              }
            }
          ],
          "next_workflow": "w.execution"
        }
      ]
    },
    {
      "id": "w.attach",
      "name": "購買申請への見積書添付",
      "bindings": [
        {
          "id": "b.upload",
          "pipeline": "p.upload",
          "triggers": [
            {
              "id": "t.upload",
              "name": "申請者が見積書2件をアップロード",
              "role": "role.requester",
              "mapping": {
                "a.id": "id",
                "a.quote-a": "file_a",
                "a.quote-b": "file_b"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "w.execution",
      "name": "承認済み購買申請の発注確定",
      "bindings": [
        {
          "id": "b.confirm",
          "pipeline": "p.confirm",
          "triggers": [
            {
              "id": "t.confirm",
              "name": "承認ワークフローから起動",
              "role": "role.system",
              "mapping": {
                "a.id": "id"
              }
            }
          ]
        }
      ]
    }
  ]
}
